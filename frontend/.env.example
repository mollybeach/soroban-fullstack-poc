# Copy to `.env.local` in this directory (Next.js loads it for `next dev` / `next build`).
#
# Inventory: every `process.env.*` read under `frontend/` is listed below — only these two.
# (`lib/stellar.ts` uses NEXT_PUBLIC_CONTRACT_ID; `lib/stellar-wallets-kit-client.ts` uses
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID when enabling WalletConnect inside the kit.)

# Deployed Soroban contract id on Stellar testnet (starts with C...).
# After `make deploy`, the script prints `CONTRACT_ID=C...` — paste that value here (and in Vercel env for hosted builds).
NEXT_PUBLIC_CONTRACT_ID=

# WalletConnect Cloud / Reown — create a project at https://dashboard.reown.com
# Optional: adds WalletConnect to Stellar Wallets Kit’s picker (`stellar:testnet`). Omit to use extensions only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# -----------------------------------------------------------------------------
# Not Next.js — optional env for `scripts/export-test-results.mjs` (repo root).
# Set in the shell or CI when using tee'd contract test logs; Next does not read these.
# -----------------------------------------------------------------------------
# CONTRACT_TEST_LOG_PATH=
# CONTRACT_TEST_LOG_EXIT=
